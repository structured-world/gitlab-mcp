    "nx/undici": "^7.30.1",
    "babel-plugin-istanbul/test-exclude": "^8.0.0",
    "prisma/mysql2": "^3.23.1",
    "@prisma/config/deepmerge-ts": "^8.0.2",
    "diff": "4.0.4",
