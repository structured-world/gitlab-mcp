{
  "name": "@structured-world/gitlab-mcp-db",
  "version": "10.1.0",
  "description": "Optional PostgreSQL/Prisma OAuth-storage backend for @structured-world/gitlab-mcp",
  "license": "Apache-2.0",
  "author": "Dmitry Prudnikov <mail@polaz.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/structured-world/gitlab-mcp",
    "directory": "packages/gitlab-mcp-db"
  },
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "test": "jest",
    "postinstall": "node -e \"if (require('fs').existsSync('prisma/schema.prisma')) require('child_process').execSync('prisma generate', { stdio: 'inherit' })\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.7",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@structured-world/gitlab-mcp": "workspace:^",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.9",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
