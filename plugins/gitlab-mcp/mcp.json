{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "gitlab-sw": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "--package",
        "@structured-world/gitlab-mcp@12.1.0",
        "gitlab-mcp-plugin",
        "${PLUGIN_DATA}"
      ],
      "cwd": "${PLUGIN_ROOT}"
    }
  }
}
